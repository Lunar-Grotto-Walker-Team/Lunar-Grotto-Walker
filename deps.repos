# 第三方依赖清单（vcstool）
#
# 用法：
#   vcs import src < deps.repos     # 首次拉取
#   vcs pull src                    # 后续更新
#
# 为什么指向 vendor 仓库而不是各上游：
#   vendor 仓库里带着我们对上游的适配改动（现场 IP、CycloneDDS 配置、
#   BehaviorTree deadline 修复等）。从上游克隆得到的是**未适配**的代码，
#   照着 UPSTREAM.md 手工打补丁既容易漏、也无法保证版本组合一致。
#   上游跟踪由 vendor 仓库自己用 `git subtree pull` 完成，主仓库不关心。
#
# 版本以完整 commit SHA 固定，保证任何人拉到的都是验证过的那一套。
# vendor 仓库打 tag 后可换成 `version: v0.1.0-alpha`。
#
# 这里有两个仓库：vendor（第三方驱动与基础库）和 pointlio（GPL-2.0 的
# Point-LIO 前端，单独成仓库做许可证隔离）。两者都用 vcs import 落到 src/ 下。

repositories:
  vendor:
    type: git
    url: https://github.com/Lunar-Grotto-Walker-Team/Lunar-Grotto-Walker-Vendor.git
    version: 78612d675af13927558cc172c09f0d2afb09ce2c

  # GPL-2.0 的 Point-LIO 前端单独成仓库（许可证隔离），落地路径仍是
  # src/point_lio_ros2，包名 point_lio 不变。详见 docs/dependencies.md 1.2。
  pointlio:
    type: git
    url: https://github.com/Lunar-Grotto-Walker-Team/Lunar-Grotto-Walker-PointLIO.git
    version: d01a319d8e0f6f9efa5eb43f80e6e79834f9a42b

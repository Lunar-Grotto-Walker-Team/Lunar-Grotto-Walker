<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_front_camera_driver</name>
  <version>0.1.0</version>
  <description>
    Unitree Go2 front monocular camera driver.
    Subscribes UDP multicast 230.1.1.1:1720 (H.264 RTP), decodes via GStreamer + OpenCV,
    publishes sensor_msgs/Image + sensor_msgs/CameraInfo pair on realsense-aligned topics.
  </description>
  <maintainer email="user@example.com">go2_dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>camera_info_manager</depend>
  <depend>image_transport</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
